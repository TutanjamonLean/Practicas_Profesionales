# Copiar este archivo a .env y ajustar los valores.
# El archivo .env no se versiona (está en .gitignore).
#
# En Render NO hace falta crear .env: las variables se cargan en el panel del
# servicio (Environment). Render define PORT automáticamente, así que no hay
# que configurarla allí.

# Puerto del servidor (por defecto 8080). En Render se ignora porque Render
# inyecta su propio PORT.
PORT=8080

# Orígenes permitidos para CORS, separados por coma.
# Si se deja vacío se acepta cualquier origen, cómodo para desarrollo local.
# Ejemplo local: http://localhost:5500,http://127.0.0.1:5500
#
# Si el frontend se publica como Static Site aparte, definir acá la URL del
# frontend (sin barra final). Reemplazar <...> por el dominio real de Render:
# BIBLIO_ORIGENES=https://<nombre-del-frontend>.onrender.com
BIBLIO_ORIGENES=
