# Copiar este archivo a .env y ajustar los valores.
# El archivo .env no se versiona (está en .gitignore).

# Puerto del servidor (por defecto 8080).
PORT=8080

# Orígenes permitidos para CORS, separados por coma.
# Si se deja vacío se acepta cualquier origen, cómodo para desarrollo local.
# Ejemplo: http://localhost:5500,http://127.0.0.1:5500
BIBLIO_ORIGENES=
